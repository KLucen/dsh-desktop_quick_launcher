{
  "name": "dsh-desktop_quick_launcher",
  "version": "0.2.2",
  "description": "Desktop quick launcher for dsh web (independent rebuild of the retired @linxin666/dsh-desktop-launcher): a double-click desktop icon that starts dsh web and opens the Web GUI with tiered port probing and captured child output, a floating Web UI panel to create/refresh the icon, restart the service through a scheduled-task helper that is verified to be running before the host exits, and exit the host gracefully — refusing to cut off an answer that is still generating — plus a Settings card that chooses which floating buttons appear and manages the plugin's own logs.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "lib/index.mjs",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./client": {
      "types": "./lib/client.d.mts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.2-alpha.4"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "NOTICE",
    "LICENSE"
  ],
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-rc.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.0",
    "typescript": "~5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "build": "tsdown && node scripts/wrap-client.mjs && node scripts/verify-client.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test \"test/**/*.test.mjs\"",
    "watch": "node scripts/wrap-client.mjs --watch"
  }
}
